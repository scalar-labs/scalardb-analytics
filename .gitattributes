#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start scripts should use lf. These patterns are intentionally
# unanchored so they match the wrappers wherever they live in the tree.
gradlew         text eol=lf
mill            text eol=lf
*.sh            text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Binary files should be left untouched
*.jar           binary
